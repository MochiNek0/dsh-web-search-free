{
  "name": "dsh-plugin-web-search-free",
  "version": "1.0.0",
  "description": "Free web search plugin for dsh supporting firecrawl and tavily",
  "keywords": [
    "dsh-plugin",
    "web-search"
  ],
  "dsh": {
    "name": "web-search-free",
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "default": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "koishi": {
    "description": "免费 Web Search 与内容抓取 (支持多引擎轮询 fallback)"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node wrap-client.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.0.1-rc.3"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^19.2.18",
    "cordis": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "cordis": "^3.0.0"
  }
}
